OG_SUITE_BIND=127.0.0.1:8080
DATABASE_URL=postgres://og_suite:og_suite@localhost:5432/og_suite
OG_SUITE_STORAGE_ROOT=./storage-dev

# Local transcription defaults to auto-detecting whisper.cpp when
# backend/models/ggml-tiny.en.bin exists. Run scripts/setup-local-whisper.sh.
# OG_TRANSCRIPTION_ENGINE=whisper_cpp
# OG_WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
# OG_WHISPER_CPP_MODEL=./backend/models/ggml-tiny.en.bin

# Generic local command mode. The backend writes audio to INPUT_PATH.
# OG_TRANSCRIPTION_ENGINE=command
# OG_TRANSCRIPTION_COMMAND='my-transcriber "$INPUT_PATH"'
